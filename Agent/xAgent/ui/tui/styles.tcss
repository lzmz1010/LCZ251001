/* xAgent TUI — 医疗健康 · 浅色清爽主题
   浅色底 + 白色面板 + 深色正文；青色作为强调，边界清晰、留白充足 */

/* ---------- 配色基准 ----------
   背景 #f3f6f8 · 面板 #ffffff · 凸起 #eef2f5 · 边框 #d8e1e8
   正文 #1c252c · 次要 #5f6d78 · 强调青 #0ea794 */

Screen {
    layout: vertical;
    background: #f3f6f8;
}

/* ---------- 顶栏 ---------- */
Header {
    dock: top;
    height: 1;
    background: #ffffff;
    color: #5f6d78;
    border-bottom: solid #0ea794;
}

HeaderTitle {
    color: #0b7d6e;
    text-style: bold;
}

HeaderClock {
    color: #5f6d78;
}

Footer {
    background: #ffffff;
    color: #5f6d78;
}

/* ---------- 主体 ---------- */
#main {
    height: 1fr;
    width: 100%;
}

#chat {
    width: 1fr;
    height: 1fr;
    padding: 1 3;
    scrollbar-size-vertical: 1;
    background: #f3f6f8;
}

/* 右侧 MCP 边栏 */
#mcp.mcp-sidebar {
    width: 26;
    height: 1fr;
    background: #ffffff;
    border-left: solid #d8e1e8;
    padding: 1 1;
    color: #5f6d78;
}

/* 上下文占用信息栏（输入区上方） */
#context {
    height: 1;
    padding: 0 3;
    background: #f3f6f8;
    color: #5f6d78;
    text-style: dim;
}

/* ---------- 消息气泡 ---------- */
.bubble {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 1 2;
}

.bubble-title {
    height: 1;
    text-style: bold;
}

.bubble Markdown {
    padding: 0 1;
    color: #1c252c;
}

/* 用户消息：浅青底 + 青色圆角边框 */
.bubble-user {
    background: #e6f7f3;
    border: round #0ea794;
}

.bubble-user .bubble-title {
    color: #0b7d6e;
}

/* AI 回复：无边框，宽松间距，正文最暗 */
.bubble-assistant {
    border: none;
    margin-bottom: 2;
}

.bubble-assistant .bubble-title {
    color: #1f8a4c;
}

.bubble-assistant Markdown {
    color: #1c252c;
}

/* 工具调用结果：浅灰面板 + 琥珀色标题 */
.bubble-tool {
    background: #eef2f5;
    border: round #d8e1e8;
}

.bubble-tool .bubble-title {
    color: #b9791f;
}

/* 系统提示：弱化斜体 */
.bubble-system {
    border: none;
    color: #5f6d78;
    text-style: italic;
}

.bubble-system .bubble-title {
    display: none;
}

/* 工具气泡：默认折叠为一行，不打扰正文 */
.bubble.compact {
    height: auto;
    min-height: 1;
    margin-top: 0;
    margin-bottom: 1;
    padding: 0 1 0 1;
    border: none;
    background: #f3f6f8;
    opacity: 0.75;
}

.bubble.compact .compact-summary {
    height: 1;
    overflow: hidden;
    text-style: dim italic;
    color: #5f6d78;
}

.bubble.compact .compact-detail {
    padding: 1 1 1 2;
    color: #5f6d78;
    text-style: dim;
}

/* 错误：浅红描边 */
.bubble-error {
    border: round #f3a7a3;
    background: #fdeceb;
    color: #c0392b;
}

.bubble-error .bubble-title {
    color: #c0392b;
}

/* ---------- 弹出面板 ---------- */
#palette, #session-list {
    height: auto;
    max-height: 14;
    border: round #d8e1e8;
    background: #ffffff;
    padding: 0 1;
}

.overlay-title {
    height: 1;
    text-style: bold;
    color: #0b7d6e;
}

.overlay-list {
    height: auto;
    max-height: 12;
}

.overlay-item {
    height: auto;
    padding: 0 1;
}

.overlay-list ListItem {
    margin-bottom: 0;
}

/* ---------- 输入区 ---------- */
#composer {
    height: auto;
    padding: 1 3 1 3;
    background: #ffffff;
    border-top: solid #d8e1e8;
}

#input {
    width: 1fr;
    height: 4;
    background: #ffffff;
    border: round #c9d4dd;
    padding: 0 1;
    color: #1c252c;
}

#input:focus {
    border: round #0ea794;
}

#send {
    width: 10;
    height: 3;
    margin: 1 0 0 1;
    background: #0ea794;
    color: #ffffff;
    text-style: bold;
}

/* ---------- 状态栏 ---------- */
#status {
    height: 1;
    padding: 0 3;
    background: #ffffff;
    color: #5f6d78;
}
