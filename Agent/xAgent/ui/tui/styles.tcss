/* xAgent TUI — 全新简洁深色主题
   用固定配色而非默认主题变量，保证在不同终端下都呈现统一的观感 */

Screen {
    layout: vertical;
    background: #0b0f14;
}

/* ---------- 顶栏：单行、低调 ---------- */
Header {
    dock: top;
    height: 1;
    background: #0b0f14;
    color: #7c8aa2;
    border-bottom: solid #1c2531;
}

HeaderTitle {
    color: #58a6ff;
    text-style: bold;
}

HeaderClock {
    color: #7c8aa2;
}

Footer {
    background: #0b0f14;
    color: #7c8aa2;
}

/* ---------- 主体 ---------- */
#main {
    height: 1fr;
    width: 100%;
}

#chat {
    width: 1fr;
    height: 1fr;
    padding: 1 3;
    scrollbar-size-vertical: 1;
    background: #0b0f14;
}

/* 右侧 MCP 边栏 */
#mcp.mcp-sidebar {
    width: 28;
    height: 1fr;
    background: #0e141c;
    border-left: solid #1c2531;
    padding: 1 1;
    color: #64748b;
}

/* 上下文占用信息栏（位于输入区上方，与输入区分隔由 #composer 边框承担） */
#context {
    height: 1;
    padding: 0 3;
    background: #111825;
    color: #8b9aab;
    text-style: dim;
}

/* ---------- 消息气泡 ---------- */
.bubble {
    width: 100%;
    height: auto;
    margin-bottom: 1;
    padding: 1 2;
}

.bubble-title {
    height: 1;
    text-style: bold;
}

.bubble Markdown {
    padding: 0 1;
    color: #d6dee7;
}

/* 用户消息：蓝色底 + 圆角边框 */
.bubble-user {
    background: #16283b;
    border: round #2a4d6e;
}

.bubble-user .bubble-title {
    color: #6db4ff;
}

/* AI 回复：无边框，宽松间距，正文最亮 */
.bubble-assistant {
    border: none;
    margin-bottom: 2;
}

.bubble-assistant .bubble-title {
    color: #74e0a5;
}

.bubble-assistant Markdown {
    color: #e3eaf1;
}

/* 工具调用结果：琥珀色 */
.bubble-tool {
    background: #171d27;
    border: round #3a3f2b;
}

.bubble-tool .bubble-title {
    color: #e3b564;
}

/* 系统提示：弱化斜体 */
.bubble-system {
    border: none;
    color: #8b9aab;
    text-style: italic;
}

.bubble-system .bubble-title {
    display: none;
}

/* 工具气泡：默认折叠为一行，几乎不可见，不打扰正文 */
.bubble.compact {
    height: auto;
    min-height: 1;
    margin-top: 0;
    margin-bottom: 1;
    padding: 0 1 0 1;
    border: none;
    background: #0b0f14;
    opacity: 0.5;
}

.bubble.compact .compact-summary {
    height: 1;
    overflow: hidden;
    text-style: dim italic;
    color: #64748b;
}

.bubble.compact .compact-detail {
    padding: 1 1 1 2;
    color: #7c8aa2;
    text-style: dim;
}

/* 错误：红色描边 */
.bubble-error {
    border: round #5c2f33;
    color: #ff8585;
}

.bubble-error .bubble-title {
    color: #ff8585;
}

/* ---------- 弹出面板 ---------- */
#palette, #session-list {
    height: auto;
    max-height: 14;
    border: round #2a4d6e;
    background: #121926;
    padding: 0 1;
}

.overlay-title {
    height: 1;
    text-style: bold;
    color: #58a6ff;
}

.overlay-list {
    height: auto;
    max-height: 12;
}

.overlay-item {
    height: auto;
    padding: 0 1;
}

.overlay-list ListItem {
    margin-bottom: 0;
}

/* ---------- 输入区 ---------- */
#composer {
    height: auto;
    padding: 1 3 1 3;
    background: #11161f;
    border-top: solid #1c2531;
}

#input {
    width: 1fr;
    height: 4;
    background: #0b0f14;
    border: round #31506e;
    padding: 0 1;
    color: #d6dee7;
}

#input:focus {
    border: round #58a6ff;
}

#send {
    width: 10;
    height: 3;
    margin: 1 0 0 1;
}

/* ---------- 状态栏 ---------- */
#status {
    height: 1;
    padding: 0 3;
    background: #11161f;
    color: #7c8aa2;
}